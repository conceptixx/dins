# =============================================================================
# DINS WebUI Setup Dockerfile
# Location: /dins/install/_webui.sh/docker/Dockerfile.webui
# =============================================================================

FROM python:3.11-slim-bookworm

# Labels
LABEL maintainer="DINS Team"
LABEL description="DINS Setup WebUI Container"
LABEL version="1.0"

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DINS_BASE_DIR=/opt/dins \
    DINS_CONFIG_DIR=/opt/dins/config \
    DINS_LOG_DIR=/opt/dins/logs \
    DINS_SECRETS_DIR=/opt/dins/secrets \
    DINS_WEBUI_DIR=/opt/dins/webui

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    curl \
    procps \
    net-tools \
    iputils-ping \
    openssh-client \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create dins-system group and set up directories
RUN groupadd -r dins-system || true \
    && mkdir -p ${DINS_BASE_DIR} \
    && mkdir -p ${DINS_CONFIG_DIR} \
    && mkdir -p ${DINS_LOG_DIR} \
    && mkdir -p ${DINS_SECRETS_DIR} \
    && mkdir -p ${DINS_WEBUI_DIR}/backend \
    && mkdir -p ${DINS_WEBUI_DIR}/frontend \
    && chown -R root:dins-system ${DINS_BASE_DIR} \
    && chmod -R 750 ${DINS_BASE_DIR} \
    && chmod 700 ${DINS_SECRETS_DIR}

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    pydantic==2.5.2 \
    pydantic-settings==2.1.0 \
    python-multipart==0.0.6 \
    email-validator==2.1.0

# Copy backend
COPY backend/ ${DINS_WEBUI_DIR}/backend/

# Copy frontend
COPY frontend/ ${DINS_WEBUI_DIR}/frontend/

# Copy nginx configuration
COPY docker/nginx.d/dins-setup.conf /etc/nginx/conf.d/dins-setup.conf

# Remove default nginx config
RUN rm -f /etc/nginx/sites-enabled/default \
    && rm -f /etc/nginx/conf.d/default.conf

# Set proper permissions
RUN chown -R root:dins-system ${DINS_WEBUI_DIR} \
    && find ${DINS_WEBUI_DIR} -type d -exec chmod 750 {} \; \
    && find ${DINS_WEBUI_DIR} -type f -exec chmod 640 {} \;

# Copy entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose ports
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/api/health || exit 1

# Working directory
WORKDIR ${DINS_WEBUI_DIR}

# Entrypoint
ENTRYPOINT ["/entrypoint.sh"]

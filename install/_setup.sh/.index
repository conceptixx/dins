### FILE
file_name: _run_cmd.sh
file_type: code
language_or_format: bash
role: Function module for executing shell commands.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_string.sh
status: active
notes: Supports sudo and interactive prompts.

functions:
  - name: _run_cmd
    kind: function
    purpose: Executes a shell command with optional sudo.
    usage_examples:
      - _run_cmd "PROMPT=apt-get update" "SUDO=true"
    parameters:
      - name: PROMPT
        type: string
        required: true
        default: none
        description: Command to execute.
        allowed_values:
          - none
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo.
        allowed_values:
          - "true"
          - "false"
      - name: DESCRIPTION
        type: string
        required: false
        default: none
        description: Human-readable description for logging.
        allowed_values:
          - none
    returns:
      type: int
      description: Exit code from the executed command.
    side_effects:
      - Executes arbitrary commands on the system
    errors:
      - condition: Command fails
        behavior: Returns the command's exit code
    messages:
      - type: stdout
        content: Command output
---

### FILE
file_name: _set_var.sh
file_type: code
language_or_format: bash
role: Function module for setting global variables in the installer context.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_string.sh
status: active
notes: Variables set by this module are available for placeholder resolution.

functions:
  - name: _set_var
    kind: function
    purpose: Sets a global variable for use in subsequent operations.
    usage_examples:
      - _set_var "NAME=BASE_DIR" "VALUE=/opt/dins"
    parameters:
      - name: NAME
        type: string
        required: true
        default: none
        description: Variable name.
        allowed_values:
          - none
      - name: VALUE
        type: string
        required: true
        default: none
        description: Variable value.
        allowed_values:
          - none
    returns:
      type: int
      description: Exit code (0=success).
    side_effects:
      - Sets environment variable
    errors:
      - condition: Empty name
        behavior: Returns exit code 1
    messages:
      - type: stdout
        content: NAME=VALUE
---

### FILE
file_name: _symlink.sh
file_type: code
language_or_format: bash
role: Function module for creating symbolic links.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_path.sh
status: active
notes: Supports sudo and force overwrite.

functions:
  - name: _symlink
    kind: function
    purpose: Creates a symbolic link from target to link_path.
    usage_examples:
      - _symlink "TARGET=/opt/dins/cli/dinser" "LINK=/usr/local/bin/dinser"
    parameters:
      - name: TARGET
        type: path
        required: true
        default: none
        description: Target file/directory.
        allowed_values:
          - none
      - name: LINK
        type: path
        required: true
        default: none
        description: Symlink path to create.
        allowed_values:
          - none
      - name: FORCE
        type: bool
        required: false
        default: "false"
        description: Overwrite existing link.
        allowed_values:
          - "true"
          - "false"
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: int
      description: Exit code (0=success, 1=config error, 2=runtime error).
    side_effects:
      - Creates symbolic link on filesystem
    errors:
      - condition: Target not found
        behavior: Returns exit code 1
      - condition: Permission denied
        behavior: Returns exit code 2
    messages:
      - type: stdout
        content: LINK=<created_link>
---

### FILE
file_name: _template.sh
file_type: code
language_or_format: bash
role: Function module for processing template files with variable substitution.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_path.sh
  - _validate_file.sh
status: active
notes: Expands placeholders in template files using current variable context.

functions:
  - name: _template
    kind: function
    purpose: Processes a template file, substituting placeholders with values.
    usage_examples:
      - _template "SOURCE=/path/template.conf.tpl" "DEST=/etc/app.conf"
    parameters:
      - name: SOURCE
        type: path
        required: true
        default: none
        description: Source template file.
        allowed_values:
          - none
      - name: DEST
        type: path
        required: true
        default: none
        description: Destination file.
        allowed_values:
          - none
      - name: MODE
        type: string
        required: false
        default: "644"
        description: Permission mode for output file.
        allowed_values:
          - none
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: int
      description: Exit code (0=success, 1=config error, 2=runtime error).
    side_effects:
      - Creates processed file from template
    errors:
      - condition: Template not found
        behavior: Returns exit code 1
      - condition: Unresolved placeholder
        behavior: Returns exit code 1
    messages:
      - type: stdout
        content: DEST=<created_file>
---

### FILE
file_name: _echo.sh
file_type: code
language_or_format: bash
role: Function module for displaying messages to the user.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - none
status: active
notes: Supports different message types (info, warn, error).

functions:
  - name: _echo
    kind: function
    purpose: Displays a formatted message to the user.
    usage_examples:
      - _echo "MESSAGE=Installation complete" "TYPE=info"
    parameters:
      - name: MESSAGE
        type: string
        required: true
        default: none
        description: Message to display.
        allowed_values:
          - none
      - name: TYPE
        type: enum
        required: false
        default: "info"
        description: Message type for formatting.
        allowed_values:
          - "info"
          - "warn"
          - "error"
          - "success"
    returns:
      type: int
      description: Exit code (0=success).
    side_effects:
      - Outputs to stdout/stderr
    errors:
      - condition: unknown
        behavior: unknown
    messages:
      - type: stdout
        content: Formatted message
---

### FILE
file_name: _validate_path.sh
file_type: code
language_or_format: bash
role: Validator module for file/directory paths.
used_by:
  - _mkdir.sh, _copy.sh, _chmod.sh, _chuser.sh, _chgroup.sh, _symlink.sh, _template.sh
depends_on:
  - none
status: active
notes: Validates that a value is a valid filesystem path.

functions:
  - name: _validate_path
    kind: function
    purpose: Validates that a value is a valid filesystem path.
    usage_examples:
      - _validate_path "/opt/dins"
    parameters:
      - name: VALUE
        type: string
        required: true
        default: none
        description: Path value to validate.
        allowed_values:
          - none
      - name: DEFAULT
        type: string
        required: false
        default: none
        description: Default value if VALUE is empty.
        allowed_values:
          - none
    returns:
      type: string
      description: Validated path on stdout.
    side_effects:
      - none
    errors:
      - condition: Invalid path format
        behavior: Returns exit code 1
    messages:
      - type: stdout
        content: Validated path value
---


    kind: function
    purpose: Validates that a value is a valid filename.
    usage_examples:
      - _validate_file "config.yml"
    parameters:
      - name: VALUE
        type: string
        required: true
        default: none
        description: Filename to validate.
        allowed_values:
          - none
      - name: DEFAULT
        type: string
        required: false
        default: none
        description: Default value if VALUE is empty.
        allowed_values:
          - none
    returns:
      type: string
      description: Validated filename on stdout.
    side_effects:
      - none
    errors:
      - condition: Invalid filename format
        behavior: Returns exit code 1
    messages:
      - type: stdout
        content: Validated filename
---

### FILE
file_name: _validate_chmod_mode.sh
file_type: code
language_or_format: bash
role: Validator module for chmod permission modes.
used_by:
  - _mkdir.sh, _copy.sh, _chmod.sh, _template.sh
depends_on:
  - none
status: active
notes: Validates 3-4 digit octal permission modes (e.g., 755, 0644, 1777).

functions:
  - name: _validate_chmod_mode
    kind: function
    purpose: Validates that a value is a valid chmod permission mode.
    usage_examples:
      - _validate_chmod_mode "755"
    parameters:
      - name: VALUE
        type: string
        required: true
        default: none
        description: Permission mode to validate.
        allowed_values:
          - none
      - name: DEFAULT
        type: string
        required: false
        default: "755"
        description: Default mode if VALUE is empty.
        allowed_values:
          - none
    returns:
      type: string
      description: Validated mode on stdout.
    side_effects:
      - none
    errors:
      - condition: Invalid mode format
        behavior: Returns exit code 1
    messages:
      - type: stdout
        content: Validated mode value
---

### FILE
file_name: _validate_boolean.sh
file_type: code
language_or_format: bash
role: Validator module for boolean values.
used_by:
  - All modules with boolean parameters
depends_on:
  - none
status: active
notes: Accepts true/false, yes/no, 1/0 and normalizes to "true" or "false".

functions:
  - name: _validate_boolean
    kind: function
    purpose: Validates and normalizes a boolean value.
    usage_examples:
      - _validate_boolean "yes"
    parameters:
      - name: VALUE
        type: string
        required: true
        default: none
        description: Boolean value to validate.
        allowed_values:
          - none
      - name: DEFAULT
        type: string
        required: false
        default: "false"
        description: Default value if VALUE is empty.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: string
      description: Normalized boolean ("true" or "false").
    side_effects:
      - none
    errors:
      - condition: Invalid boolean format
        behavior: Returns exit code 1
    messages:
      - type: stdout
        content: "true" or "false"
---


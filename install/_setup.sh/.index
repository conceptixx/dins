### DIRECTORIES
subdirectories:
  - name: cli
    path: install/_setup.sh/cli
    role: Contains DINSER CLI executable, command modules, and setup scripts.
  - name: docker
    path: install/_setup.sh/docker
    role: Contains Docker Compose and Dockerfile for the setup service.
  - name: lib
    path: install/_setup.sh/lib
    role: Shared library functions (state.sh for state management per PART 6.1).
---

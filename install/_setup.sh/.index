### META
directory_path: install/_setup.sh
last_updated: 2025-11-28T14:45:00Z
description: Base installer engine directory containing the Manifest, function modules for file operations, validators for parameter checking, CLI tools (DINSER), and Docker configurations for the setup service.
notes: This is the core installer referenced by setup.sh. All modules follow the declaration syntax specified in AI instructions - 1 - base.claude.
---

### FILE
file_name: Manifest
file_type: config
language_or_format: text
role: Declarative installation manifest that defines all installation phases and operations for the DINS system including system preparation, runtime environment setup, Docker Swarm, and DINSER CLI installation.
used_by:
  - install/setup.sh
depends_on:
  - All _*.sh modules in this directory
  - All _validate_*.sh validators
status: active
notes: Main configuration file for the installer orchestrator.

functions:
  - none
---

### FILE
file_name: _mkdir.sh
file_type: code
language_or_format: bash
role: Function module for creating directories with specified permissions.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_path.sh
  - _validate_chmod_mode.sh
status: active
notes: Supports recursive creation and sudo operation.

functions:
  - name: _mkdir
    kind: function
    purpose: Creates a directory with specified path and mode.
    usage_examples:
      - _mkdir "PATH=/opt/dins" "MODE=755"
    parameters:
      - name: PATH
        type: path
        required: true
        default: none
        description: Directory path to create.
        allowed_values:
          - none
      - name: MODE
        type: string
        required: false
        default: "755"
        description: Permission mode for the directory.
        allowed_values:
          - none
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo for creation.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: int
      description: Exit code (0=success, 1=config error, 2=runtime error).
    side_effects:
      - Creates directory on filesystem
    errors:
      - condition: Invalid path
        behavior: Returns exit code 1
      - condition: Permission denied
        behavior: Returns exit code 2
    messages:
      - type: stdout
        content: PATH=<created_path>
---

### FILE
file_name: _copy.sh
file_type: code
language_or_format: bash
role: Function module for copying files with specified permissions.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_path.sh
  - _validate_file.sh
  - _validate_chmod_mode.sh
status: active
notes: Supports sudo operation.

functions:
  - name: _copy
    kind: function
    purpose: Copies a file from source to destination with optional mode.
    usage_examples:
      - _copy "SOURCE=/path/to/file" "DEST=/path/to/dest" "MODE=644"
    parameters:
      - name: SOURCE
        type: path
        required: true
        default: none
        description: Source file path.
        allowed_values:
          - none
      - name: DEST
        type: path
        required: true
        default: none
        description: Destination file path.
        allowed_values:
          - none
      - name: MODE
        type: string
        required: false
        default: none
        description: Permission mode for the copied file.
        allowed_values:
          - none
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo for copying.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: int
      description: Exit code (0=success, 1=config error, 2=runtime error).
    side_effects:
      - Copies file on filesystem
      - Sets file permissions
    errors:
      - condition: Source file not found
        behavior: Returns exit code 1
      - condition: Permission denied
        behavior: Returns exit code 2
    messages:
      - type: stdout
        content: DEST=<destination_path>
---

### FILE
file_name: _chmod.sh
file_type: code
language_or_format: bash
role: Function module for changing file/directory permissions.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_path.sh
  - _validate_chmod_mode.sh
status: active
notes: Supports recursive and sudo operations.

functions:
  - name: _chmod
    kind: function
    purpose: Changes permissions on a file or directory.
    usage_examples:
      - _chmod "PATH=/opt/dins" "MODE=755" "RECURSIVE=true"
    parameters:
      - name: PATH
        type: path
        required: true
        default: none
        description: Path to modify.
        allowed_values:
          - none
      - name: MODE
        type: string
        required: true
        default: none
        description: Permission mode to set.
        allowed_values:
          - none
      - name: RECURSIVE
        type: bool
        required: false
        default: "false"
        description: Apply recursively.
        allowed_values:
          - "true"
          - "false"
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: int
      description: Exit code (0=success, 1=config error, 2=runtime error).
    side_effects:
      - Changes file permissions
    errors:
      - condition: Invalid path
        behavior: Returns exit code 1
      - condition: Permission denied
        behavior: Returns exit code 2
    messages:
      - type: stdout
        content: MODE=<applied_mode>
---

### FILE
file_name: _chuser.sh
file_type: code
language_or_format: bash
role: Function module for changing file/directory owner.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_path.sh
  - _validate_user.sh
status: active
notes: Supports recursive and sudo operations.

functions:
  - name: _chuser
    kind: function
    purpose: Changes owner of a file or directory.
    usage_examples:
      - _chuser "PATH=/opt/dins" "USER=root" "RECURSIVE=true"
    parameters:
      - name: PATH
        type: path
        required: true
        default: none
        description: Path to modify.
        allowed_values:
          - none
      - name: USER
        type: string
        required: true
        default: none
        description: Username to set as owner.
        allowed_values:
          - none
      - name: RECURSIVE
        type: bool
        required: false
        default: "false"
        description: Apply recursively.
        allowed_values:
          - "true"
          - "false"
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: int
      description: Exit code (0=success, 1=config error, 2=runtime error).
    side_effects:
      - Changes file ownership
    errors:
      - condition: Invalid user
        behavior: Returns exit code 1
      - condition: Permission denied
        behavior: Returns exit code 2
    messages:
      - type: stdout
        content: USER=<applied_user>
---

### FILE
file_name: _chgroup.sh
file_type: code
language_or_format: bash
role: Function module for changing file/directory group.
used_by:
  - install/setup.sh via Manifest
depends_on:
  - _validate_path.sh
  - _validate_group.sh
status: active
notes: Supports recursive and sudo operations.

functions:
  - name: _chgroup
    kind: function
    purpose: Changes group of a file or directory.
    usage_examples:
      - _chgroup "PATH=/opt/dins" "GROUP=dins-system" "RECURSIVE=true"
    parameters:
      - name: PATH
        type: path
        required: true
        default: none
        description: Path to modify.
        allowed_values:
          - none
      - name: GROUP
        type: string
        required: true
        default: none
        description: Group name to set.
        allowed_values:
          - none
      - name: RECURSIVE
        type: bool
        required: false
        default: "false"
        description: Apply recursively.
        allowed_values:
          - "true"
          - "false"
      - name: SUDO
        type: bool
        required: false
        default: "false"
        description: Whether to use sudo.
        allowed_values:
          - "true"
          - "false"
    returns:
      type: int
      description: Exit code (0=success, 1=config error, 2=runtime error).
    side_effects:
      - Changes file group ownership
    errors:
      - condition: Invalid group
        behavior: Returns exit code 1
      - condition: Permission denied
        behavior: Returns exit code 2
    messages:
      - type: stdout
        content: GROUP=<applied_group>

#!/usr/bin/env bash
# =============================================================================
# DINSER - DINS Execution Resolver CLI (Modular Version)
# Location: /dins/install/_setup.sh/cli/dinser
# =============================================================================
# Refactored per PART 6.5 to support modular command handling:
# - Core commands are hardcoded (version, help, status, setup)
# - Additional commands are dynamically discovered from commands/ directory
# =============================================================================

set -euo pipefail

readonly VERSION="2.0.0"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly INSTALL_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"
readonly COMMANDS_DIR="${SCRIPT_DIR}/commands"
readonly WEBUI_SCRIPT="${INSTALL_DIR}/webui.sh"
readonly STATE_DIR="/var/lib/dins"
readonly STATE_FILE="${STATE_DIR}/setup_state"

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m'

# Logging functions
log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
log_debug() { [[ "${DEBUG:-0}" == "1" ]] && echo -e "${CYAN}[DEBUG]${NC} $*"; }

# =============================================================================
# DYNAMIC COMMAND DISCOVERY
# =============================================================================

# Discover available modular commands
discover_commands() {
    local commands=()
    
    if [[ -d "$COMMANDS_DIR" ]]; then
        for cmd_file in "$COMMANDS_DIR"/*.sh; do
            [[ -f "$cmd_file" ]] || continue
            local cmd_name
            cmd_name="$(basename "$cmd_file" .sh)"
            commands+=("$cmd_name")
        done
        
        # Also check for subdirectories (multi-level commands)
        for cmd_dir in "$COMMANDS_DIR"/*/; do
            [[ -d "$cmd_dir" ]] || continue
            local cmd_name
            cmd_name="$(basename "$cmd_dir")"
            # Only add if not already in list
            if [[ ! " ${commands[*]} " =~ " ${cmd_name} " ]]; then
                commands+=("$cmd_name")
            fi
        done
    fi
    
    echo "${commands[@]}"
}

# Get description for a modular command
get_command_description() {
    local cmd_name="$1"
    local cmd_file="${COMMANDS_DIR}/${cmd_name}.sh"
    local desc="(dynamic command)"
    
    if [[ -f "$cmd_file" ]]; then
        # Try to extract description from # description: comment
        local extracted
        extracted=$(grep -m1 "^# description:" "$cmd_file" 2>/dev/null | sed 's/^# description:[[:space:]]*//')
        [[ -n "$extracted" ]] && desc="$extracted"
    fi
    
    echo "$desc"
}

# Execute a modular command
execute_modular_command() {
    local cmd_name="$1"
    shift
    
    local cmd_file="${COMMANDS_DIR}/${cmd_name}.sh"
    local cmd_dir="${COMMANDS_DIR}/${cmd_name}"
    
    # Check for direct command file
    if [[ -f "$cmd_file" ]]; then
        # shellcheck source=/dev/null
        source "$cmd_file"
        
        # Call the main function if it exists
        local main_func="cmd_${cmd_name}"
        if declare -f "$main_func" > /dev/null 2>&1; then
            "$main_func" "$@"
            return $?
        else
            log_error "Command module '$cmd_name' has no entry function '$main_func'"
            return 1
        fi
    fi
    
    # Check for command directory with subcommands
    if [[ -d "$cmd_dir" ]]; then
        local subcmd="${1:-}"
        
        if [[ -z "$subcmd" ]]; then
            # No subcommand - show help for this command
            if [[ -f "${cmd_dir}/help.sh" ]]; then
                source "${cmd_dir}/help.sh"
                return 0
            else
                log_error "Subcommand required for '$cmd_name'"
                echo "Available subcommands:"
                for sub_file in "$cmd_dir"/*.sh; do
                    [[ -f "$sub_file" ]] || continue
                    local sub_name
                    sub_name="$(basename "$sub_file" .sh)"
                    echo "  $sub_name"
                done
                return 1
            fi
        fi
        
        shift
        local sub_file="${cmd_dir}/${subcmd}.sh"
        
        if [[ -f "$sub_file" ]]; then
            source "$sub_file"
            local sub_func="cmd_${cmd_name}_${subcmd}"
            if declare -f "$sub_func" > /dev/null 2>&1; then
                "$sub_func" "$@"
                return $?
            fi
        fi
        
        log_error "Unknown subcommand: $cmd_name $subcmd"
        return 1
    fi
    
    return 1
}

# =============================================================================
# USAGE / HELP
# =============================================================================

usage() {
    cat << EOF
${BLUE}DINSER - DINS Execution Resolver v${VERSION}${NC}

${YELLOW}Usage:${NC}
    dinser <command> [subcommand] [options]

${YELLOW}Core Commands:${NC}
    version         Show version information
    help            Show this help message
    status          Show DINS system status
    setup           Run/resume DINS setup
      --init        Initialize fresh installation
      --from-beginning  Restart setup from scratch

EOF

    # Dynamic commands
    local modular_cmds
    modular_cmds=$(discover_commands)
    
    if [[ -n "$modular_cmds" ]]; then
        echo -e "${YELLOW}Additional Commands:${NC}"
        for cmd in $modular_cmds; do
            local desc
            desc=$(get_command_description "$cmd")
            printf "    %-15s %s\n" "$cmd" "$desc"
        done
        echo ""
    fi
    
    cat << EOF
${YELLOW}WebUI Commands:${NC}
    webui           Manage the WebUI setup interface
      manifest      Prepare directories and configs
      up            Start the WebUI container
      down          Stop the WebUI container
      restart       Restart the WebUI container
      status        Show WebUI container status
      logs          Show WebUI logs
      build         Build WebUI Docker image

${YELLOW}Examples:${NC}
    dinser version
    dinser status
    dinser setup
    dinser webui up
    dinser check web-ui

${YELLOW}Environment:${NC}
    DEBUG=1         Enable debug output

EOF
}

# =============================================================================
# CORE COMMANDS (Hardcoded)
# =============================================================================

cmd_version() {
    echo "DINSER v${VERSION}"
    echo "DINS - Distributed Intelligent Network Services"
    echo "Install directory: ${INSTALL_DIR}"
    echo "Commands directory: ${COMMANDS_DIR}"
}

cmd_status() {
    echo "=========================================="
    echo "DINS System Status"
    echo "=========================================="
    echo ""
    
    # Check setup state
    echo "Setup State:"
    if [[ -f "$STATE_FILE" ]]; then
        local last_phase
        last_phase=$(grep -oP 'phase\d+' "$STATE_FILE" 2>/dev/null | sort -u | tail -1)
        local completed_count
        completed_count=$(grep -c ":completed" "$STATE_FILE" 2>/dev/null || echo "0")
        echo "  State file: $STATE_FILE"
        echo "  Last phase: ${last_phase:-unknown}"
        echo "  Completed steps: $completed_count"
    else
        echo "  State file: Not found (setup not started)"
    fi
    echo ""
    
    # Check directories
    echo "Directories:"
    for dir in /opt/dins /opt/dins/config /opt/dins/logs /opt/dins/secrets; do
        if [[ -d "$dir" ]]; then
            echo "  $dir: OK"
        else
            echo "  $dir: MISSING"
        fi
    done
    echo ""
    
    # Check Docker
    echo "Docker:"
    if command -v docker &>/dev/null; then
        if docker info &>/dev/null 2>&1; then
            echo "  Status: Running"
            
            # Check for DINS containers
            if docker ps --format '{{.Names}}' | grep -q "dins"; then
                echo "  DINS Containers:"
                docker ps --format '  - {{.Names}}: {{.Status}}' | grep "dins" || true
            else
                echo "  DINS Containers: None running"
            fi
        else
            echo "  Status: Not accessible"
        fi
    else
        echo "  Status: Not installed"
    fi
    echo ""
    
    # Check config
    echo "Configuration:"
    if [[ -f "/opt/dins/config/dins_config.json" ]]; then
        echo "  Config file: OK"
    else
        echo "  Config file: Not found"
    fi
    echo ""
}

cmd_webui() {
    local subcommand="${1:-}"
    shift || true
    
    if [[ -z "$subcommand" ]]; then
        log_error "Subcommand required. Use: dinser webui <manifest|up|down|status|logs|build>"
        return 1
    fi
    
    if [[ ! -f "$WEBUI_SCRIPT" ]]; then
        log_error "WebUI script not found: $WEBUI_SCRIPT"
        return 1
    fi
    
    case "$subcommand" in
        manifest|up|down|restart|status|logs|build|shell|config-path)
            exec "$WEBUI_SCRIPT" "$subcommand" "$@"
            ;;
        *)
            log_error "Unknown webui subcommand: $subcommand"
            log_info "Valid subcommands: manifest, up, down, restart, status, logs, build"
            return 1
            ;;
    esac
}

cmd_setup() {
    local init_mode=0
    local from_beginning=0
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --init)
                init_mode=1
                shift
                ;;
            --from-beginning)
                from_beginning=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    
    local setup_script="${INSTALL_DIR}/setup.sh"
    
    if [[ ! -f "$setup_script" ]]; then
        log_error "Setup script not found: $setup_script"
        return 1
    fi
    
    # Handle --from-beginning: clear state file
    if [[ $from_beginning -eq 1 ]]; then
        log_warn "Clearing setup state to restart from beginning..."
        if [[ -f "$STATE_FILE" ]]; then
            sudo rm -f "$STATE_FILE" 2>/dev/null || rm -f "$STATE_FILE"
        fi
    fi
    
    if [[ $init_mode -eq 1 ]]; then
        log_info "Running DINS initialization..."
        exec "$setup_script" --init
    else
        log_info "Running DINS setup..."
        exec "$setup_script"
    fi
}

# =============================================================================
# MAIN DISPATCHER
# =============================================================================

main() {
    local command="${1:-}"
    shift || true
    
    # Core commands (hardcoded)
    case "$command" in
        version|-v|--version)
            cmd_version
            return 0
            ;;
        help|-h|--help|"")
            usage
            return 0
            ;;
        status)
            cmd_status
            return 0
            ;;
        setup)
            cmd_setup "$@"
            return $?
            ;;
        webui)
            cmd_webui "$@"
            return $?
            ;;
    esac
    
    # Try modular commands
    local cmd_file="${COMMANDS_DIR}/${command}.sh"
    local cmd_dir="${COMMANDS_DIR}/${command}"
    
    if [[ -f "$cmd_file" ]] || [[ -d "$cmd_dir" ]]; then
        execute_modular_command "$command" "$@"
        return $?
    fi
    
    # Unknown command
    log_error "Unknown command: $command"
    echo ""
    echo "Use 'dinser help' to see available commands."
    exit 1
}

main "$@"

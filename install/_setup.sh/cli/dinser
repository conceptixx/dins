#!/usr/bin/env bash
# =============================================================================
# DINSER - DINS Execution Resolver CLI
# Location: /dins/install/_setup.sh/cli/dinser
# =============================================================================

set -euo pipefail

readonly VERSION="1.0.0"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly INSTALL_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"
readonly WEBUI_SCRIPT="${INSTALL_DIR}/webui.sh"

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# =============================================================================
# USAGE
# =============================================================================

usage() {
    cat << EOF
${BLUE}DINSER - DINS Execution Resolver v${VERSION}${NC}

${YELLOW}Usage:${NC}
    dinser <command> [subcommand] [options]

${YELLOW}Commands:${NC}
    version         Show version information
    help            Show this help message
    status          Show DINS system status
    
    setup           Run initial setup
    setup --init    Initialize DINS installation
    
    webui           Manage the WebUI setup interface
      manifest      Prepare directories and configs
      up            Start the WebUI container
      down          Stop the WebUI container
      restart       Restart the WebUI container
      status        Show WebUI container status
      logs          Show WebUI logs
      build         Build WebUI Docker image

${YELLOW}Examples:${NC}
    dinser version
    dinser status
    dinser webui up
    dinser webui logs -f

EOF
}

# =============================================================================
# COMMANDS
# =============================================================================

cmd_version() {
    echo "DINSER v${VERSION}"
    echo "DINS - Distributed Intelligent Network Services"
    echo "Install directory: ${INSTALL_DIR}"
}

cmd_status() {
    echo "=========================================="
    echo "DINS System Status"
    echo "=========================================="
    echo ""
    
    # Check directories
    echo "Directories:"
    for dir in /opt/dins /opt/dins/config /opt/dins/logs /opt/dins/secrets; do
        if [[ -d "$dir" ]]; then
            echo "  $dir: OK"
        else
            echo "  $dir: MISSING"
        fi
    done
    echo ""
    
    # Check Docker
    echo "Docker:"
    if command -v docker &>/dev/null; then
        if docker info &>/dev/null 2>&1; then
            echo "  Status: Running"
            
            # Check for DINS containers
            if docker ps --format '{{.Names}}' | grep -q "dins"; then
                echo "  DINS Containers:"
                docker ps --format '  - {{.Names}}: {{.Status}}' | grep "dins"
            else
                echo "  DINS Containers: None running"
            fi
        else
            echo "  Status: Not accessible"
        fi
    else
        echo "  Status: Not installed"
    fi
    echo ""
    
    # Check config
    echo "Configuration:"
    if [[ -f "/opt/dins/config/dins_config.json" ]]; then
        echo "  Config file: OK"
    else
        echo "  Config file: Not found"
    fi
    echo ""
}

cmd_webui() {
    local subcommand="${1:-}"
    shift || true
    
    if [[ -z "$subcommand" ]]; then
        log_error "Subcommand required. Use: dinser webui <manifest|up|down|status|logs|build>"
        return 1
    fi
    
    if [[ ! -f "$WEBUI_SCRIPT" ]]; then
        log_error "WebUI script not found: $WEBUI_SCRIPT"
        return 1
    fi
    
    case "$subcommand" in
        manifest|up|down|restart|status|logs|build|shell|config-path)
            exec "$WEBUI_SCRIPT" "$subcommand" "$@"
            ;;
        *)
            log_error "Unknown webui subcommand: $subcommand"
            log_info "Valid subcommands: manifest, up, down, restart, status, logs, build"
            return 1
            ;;
    esac
}

cmd_setup() {
    local init_mode=0
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --init)
                init_mode=1
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    
    local setup_script="${INSTALL_DIR}/setup.sh"
    
    if [[ ! -f "$setup_script" ]]; then
        log_error "Setup script not found: $setup_script"
        return 1
    fi
    
    if [[ $init_mode -eq 1 ]]; then
        log_info "Running DINS initialization..."
        exec "$setup_script" --init
    else
        log_info "Running DINS setup..."
        exec "$setup_script"
    fi
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    local command="${1:-}"
    shift || true
    
    case "$command" in
        version|-v|--version)
            cmd_version
            ;;
        help|-h|--help|"")
            usage
            ;;
        status)
            cmd_status
            ;;
        setup)
            cmd_setup "$@"
            ;;
        webui)
            cmd_webui "$@"
            ;;
        *)
            log_error "Unknown command: $command"
            usage
            exit 1
            ;;
    esac
}

main "$@"

### FILE
file_name: test_module_installer.py
file_type: executable
language_or_format: python
role: Main test file containing all installer tests. Implements run_tests(config) function required by test suite.
used_by:
  - testsuite.py
depends_on:
  - testsuite.py (for ModuleResult, TestResult classes)
status: active
notes: Can also be run standalone with --verbose flag for debugging.

functions:
  - name: run_tests
    description: Main entry point - runs all installer tests and returns ModuleResult
  - name: test_install_directory_exists
    description: Validates install directory exists
  - name: test_setup_module_exists
    description: Checks _setup.sh module directory
  - name: test_setup_manifest_exists
    description: Validates Manifest file present
  - name: test_setup_manifest_valid
    description: Parses Manifest for syntax
  - name: test_manifest_operations_valid
    description: Validates operation fields
  - name: test_operation_scripts_exist
    description: Checks expected operation scripts
  - name: test_operation_scripts_valid
    description: Validates shell script syntax
  - name: test_validator_scripts_exist
    description: Checks validator scripts
  - name: test_cli_directory_exists
    description: Validates CLI directory
  - name: test_dinser_cli_exists
    description: Checks dinser CLI tool
  - name: test_dinser_cli_valid
    description: Validates dinser syntax
  - name: test_docker_setup_exists
    description: Checks Docker setup files
  - name: test_main_scripts_exist
    description: Validates main installer scripts
  - name: test_main_scripts_valid
    description: Validates main script syntax
  - name: test_all_manifests_parseable
    description: Recursively validates all Manifests
